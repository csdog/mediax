{
  "name": "mediax-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Local multi-platform publishing workspace for macOS, Windows, and Linux",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/csdog/mediax.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test:integration": "pnpm run build && node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "package:mac": "pnpm run build && electron-builder --mac --dir --publish never",
    "package:mac:dist": "pnpm run build && electron-builder --mac --publish never",
    "package:win": "pnpm run build && electron-builder --win --publish never",
    "package:linux": "pnpm run build && electron-builder --linux --publish never",
    "package": "pnpm run build && electron-builder --mac --win --linux --publish never",
    "test:packaged": "MEDIAX_PACKAGED=1 node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:unit": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run tests/unit",
    "test:ui": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run tests/ui",
    "postinstall": "electron-builder install-app-deps && node scripts/patch-electron-dock-name.mjs",
    "patch:dock-name": "node scripts/patch-electron-dock-name.mjs",
    "prepare": "husky",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hono/node-server": "^2.1.4",
    "@hono/zod-openapi": "^1.6.3",
    "@hookform/resolvers": "^5.9.1",
    "@preact/signals": "^2.11.3",
    "@schedule-x/calendar": "^4.9.1",
    "@schedule-x/calendar-controls": "^4.9.1",
    "@schedule-x/current-time": "^4.9.0",
    "@schedule-x/events-service": "^4.9.1",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-shadcn": "^4.9.1",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.13",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "next-themes": "^0.4.6",
    "playwright-core": "1.64.0",
    "preact": "^11.0.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.4",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "^1.0.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.1.5",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint",
      "oxfmt"
    ],
    "*.{json,jsonc,css,html,md,yaml,yml,toml}": "oxfmt"
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "packageManager": "pnpm@12.4.2+sha512.CK3GYTGAJ1x8ntraOdzwjJxhrU5+rzMKTzRh8QKw+QdCNFTRF/mOctR/7wYWBwZE17/8lzpqV/UJCm18NosHyQ=="
}
