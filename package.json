{
  "name": "media-post-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local Facebook publishing workspace for macOS",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test:integration": "pnpm run build && node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "package:mac": "pnpm run build && electron-builder --mac --dir",
    "test:packaged": "MEDIA_POST_PACKAGED=1 node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:unit": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run tests/unit",
    "test:ui": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run tests/ui",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "husky",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "next-themes": "^0.4.6",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.4",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.1.5",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint",
      "oxfmt"
    ],
    "*.{json,jsonc,css,html,md,yaml,yml,toml}": "oxfmt"
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "packageManager": "pnpm@12.4.2+sha512.CK3GYTGAJ1x8ntraOdzwjJxhrU5+rzMKTzRh8QKw+QdCNFTRF/mOctR/7wYWBwZE17/8lzpqV/UJCm18NosHyQ=="
}
